<Project Sdk="Microsoft.NET.Sdk">

  <!--
    LISH 단위 테스트 (xUnit). 실행: dotnet test tests/Lish.Tests -c Release
    build.ps1 은 src/Lish/Lish.csproj 만 빌드하므로 이 프로젝트는 dist 에 들어가지 않는다.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Lish.Tests</RootNamespace>
    <AssemblyName>Lish.Tests</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <!-- SSH.NET 의 하위 의존성(System.Memory 등) 버전 차이를 binding redirect 로 맞춘다 -->
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <!-- packages.lock.json: 테스트 의존성도 고정 (Trivy 가 읽는다) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
    <!-- net48 빌드용 참조 어셈블리 (Developer Pack 미설치 환경 대응) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Lish\Lish.csproj" />
  </ItemGroup>

</Project>
